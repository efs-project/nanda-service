# Service mode. Use offline locally; use sepolia only after setting real auth and RPC env.
EFS_SCRIBE_MODE=offline

# Local/offline auth examples. Replace before any public Sepolia deployment.
API_KEYS_JSON={"local-scribe-key":{"subject":"api-key:local-scribe-agent","allow_delete":true}}
AGENT_KEY_DERIVATION_SECRET=replace-with-random-secret

# Public URL used in receipts and docs.
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info

# Optional Kubo/IPFS API used to pin inline_base64 content before EFS writes.
# When set, inline content defaults to an ipfs:// mirror instead of metadata-only facts.
IPFS_API_URL=http://127.0.0.1:5001/api/v0
IPFS_GATEWAY_URL=
# Optional literal Authorization header for protected IPFS APIs, for example "Bearer ..."
IPFS_API_AUTHORIZATION=

# Sepolia mode placeholders. Do not commit real secrets.
SEPOLIA_RPC_URL=
EFS_CHAIN_ID=11155111
EFS_EAS_ADDRESS=0xC2679fBD37d54388Ce493F1DB75320D236e1815e
# If >0, the service sponsor tops each derived agent wallet up to this balance.
# Set 0 only when derived agent wallets are funded out of band.
SEPOLIA_AGENT_FUNDING_TARGET_WEI=20000000000000000
SERVICE_SPONSOR_PRIVATE_KEY=
# Reserved for future signed receipt support. Not required by the current MVP.
RECEIPT_SIGNER_PRIVATE_KEY=
